# Base URL for the streaming API.
#
# Leave EMPTY in normal use: requests then go to /api/... on the page's own origin,
# which Vite proxies in development and nginx proxies in production. That is what
# keeps every request same-origin and lets the API ship with no CORS allowlist.
#
# Set it only to point a local UI at a remote backend, e.g.
#   VITE_API_BASE_URL=https://staging.example.com
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api. Change if the backend is not on 8080.
VITE_DEV_API_TARGET=http://localhost:8080
