# Credentials for the VPN container. Copy to vpn.env and fill in — vpn.env is gitignored.
#
#   cp deploy/vpn.env.example deploy/vpn.env
#
# gluetun supports most commercial providers; the keys below differ per provider, and the
# authoritative list is https://github.com/qdm12/gluetun-wiki. Two common shapes:
#
# --- WireGuard (Mullvad, ProtonVPN, AirVPN, IVPN, Windscribe...) ---
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
# Optional: pin exits. Fewer, closer exits are usually faster for torrents.
SERVER_COUNTRIES=
#
# --- OpenVPN (providers without WireGuard) ---
# VPN_TYPE=openvpn
# OPENVPN_USER=
# OPENVPN_PASSWORD=

# If your provider forwards a port, put it here AND set the torrent port to match, so
# peers can open connections to you rather than only the other way round.
# TORRENT_PORT=6891
